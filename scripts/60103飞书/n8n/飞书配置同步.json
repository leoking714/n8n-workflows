      "name": "拉取飞书配置",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [220, 300],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// 把 sync_config.py 的控制台输出整理成结构化结果\nconst out = ($json.stdout || '').trim();\nconst err = ($json.stderr || '').trim();\n\n// 解析 \"商品配置    30 行\" 这种行\nconst counts = {};\nfor (const line of out.split('\\n')) {\n  const m = line.match(/^\\s*(\\S+)\\s+(\\d+)\\s+行\\s*$/);\n  if (m) counts[m[1]] = Number(m[2]);\n}\n\nconst ok = !err && Object.keys(counts).length > 0;\nreturn [{\n  json: {\n    ok,\n    counts,\n    stdout: out,\n    stderr: err\n  }\n}];"
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "解析结果",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300]
    },
