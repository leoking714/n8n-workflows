   "position": [
    -544,
    128
   ],
   "id": "430e2f39-8d90-4e28-96f0-fdff7aa0ca35",
   "name": "定义时间"
  },
  {
   "parameters": {
    "jsCode": "const startRaw = $input.first().json.startDate;\nconst endRaw = $input.first().json.endDate;\n\nconst pad2 = (n) => String(n).padStart(2, '0');\n\nfunction parseDateTime(str) {\n  // 兼容 2026-5-4、2026/5/4、2026-5-4 9:5:3、2026-05-04 09:05:03 等\n  const m = String(str).trim().match(\n    /^(\\d{4})[-/](\\d{1,2})[-/](\\d{1,2})(?:[ T](\\d{1,2}):(\\d{1,2})(?::(\\d{1,2}))?)?/\n  );\n\n  if (!m) {\n    throw new Error(`无法解析日期时间: ${str}`);\n  }\n\n  const year = Number(m[1]);\n  const month = Number(m[2]);\n  const day = Number(m[3]);\n  const hour = m[4] !== undefined ? Number(m[4]) : 0;\n  const minute = m[5] !== undefined ? Number(m[5]) : 0;\n  const second = m[6] !== undefined ? Number(m[6]) : 0;\n\n  const dateStr = `${year}-${pad2(month)}-${pad2(day)}`;\n  const dateTimeStr = `${dateStr} ${pad2(hour)}:${pad2(minute)}:${pad2(second)}`;\n\n  return {\n    year,\n    month,\n    day,\n    hour,\n    minute,\n    second,\n    dateStr,\n    dateTimeStr\n  };\n}\n\nconst start = parseDateTime(startRaw);\nconst end = parseDateTime(endRaw);\n\n// 使用 UTC 日期，避免时区导致日期错乱\nlet current = new Date(Date.UTC(start.year, start.month - 1, start.day));\nconst endDate = new Date(Date.UTC(end.year, end.month - 1, end.day));\n\nconst dateItems = [];\n\nwhile (current <= endDate) {\n  const currentDayStr = [\n    current.getUTCFullYear(),\n    pad2(current.getUTCMonth() + 1),\n    pad2(current.getUTCDate())\n  ].join('-');\n\n  let dayStart;\n  if (currentDayStr === start.dateStr) {\n    // 第一天：使用传入的开始时间，统一补零格式化\n    dayStart = start.dateTimeStr;\n  } else {\n    dayStart = `${currentDayStr} 00:00:00`;\n  }\n\n  let dayEnd;\n  if (currentDayStr === end.dateStr) {\n    // 最后一天：使用传入的结束时间，统一补零格式化\n    dayEnd = end.dateTimeStr;\n  } else {\n    dayEnd = `${currentDayStr} 23:59:59`;\n  }\n\n  dateItems.push({\n    json: {\n      api_start_time: dayStart,\n      api_end_time: dayEnd\n    }\n  });\n\n  current.setUTCDate(current.getUTCDate() + 1);\n}\n\nreturn dateItems;"
   },
