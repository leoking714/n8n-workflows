  {
   "parameters": {
    "formTitle": "生成 Bill PDF（核对后）",
    "formDescription": "### 用途\n先在计算表里核对并矫正数据，再提交这里生成客户 PDF。\n\n- 文件名留空 = 自动取 output 目录里最新的 60103计算表_*.xlsx\n- 账单日期留空 = 用今天",
    "formFields": {
     "values": [
      {
       "fieldLabel": "计算表文件名",
       "placeholder": "例：60103计算表_20261119180332.xlsx（留空=最新）"
      },
      {
       "fieldLabel": "账单日期",
       "placeholder": "例：2026. 11. 19（留空=今天）"
      },
      {
       "fieldLabel": "备注",
       "placeholder": "选填"
      },
      {
       "fieldLabel": "Last Balance",
       "placeholder": "上期余额，如 84.44（留空 = 0）"
      }
     ]
    },
    "options": {}
   },
   "type": "n8n-nodes-base.formTrigger",
   "typeVersion": 2.2,
   "position": [
    -464,
    0
   ],
   "id": "b50ffb51-c2d1-4c2f-bed1-2a497be81017",
   "name": "On form submission",
   "webhookId": "928b6ac2-c574-4bb7-85c2-4aeb5da80d17"
  },
  {
   "parameters": {
    "jsCode": "// 表单 → 脚本参数（文件名留空 = 用 output 里最新的计算表）\nconst f = $input.first().json || {};\nconst lbRaw = String(f['Last Balance'] ?? '').trim();\nconst lb = lbRaw === '' ? 0 : Number(lbRaw.replace(/[^0-9.\\-]/g, '')) || 0;\nreturn [{ json: {\n  file: String(f['计算表文件名'] || '').trim(),\n  date: String(f['账单日期'] || '').trim(),\n  note: String(f['备注'] || '').trim(),\n  last_balance: lb,\n  dir: '/data/data/workflow005/output',\n  engine: 'docx',\n} }];"
   },
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    -224,
    0
   ],
   "id": "ef2295e7-3d37-46f2-8925-566c2ca5e236",
   "name": "解析表单"
  },
  {
   "parameters": {
    "method": "POST",
    "url": "http://python-runner:8000/run",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ script: 'workflow005/scripts/pick_and_render.py', args: [JSON.stringify({ file: $json.file, date: $json.date, last_balance: $json.last_balance, dir: $json.dir, engine: $json.engine })], timeout: 900 }) }}",
    "options": {
     "timeout": 920000
    }
   },
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.5,
   "position": [
    32,
    0
   ],
   "id": "44b55d88-e22f-46c9-bef3-973354d4cfe6",
   "name": "生成Bill PDF"
  },
  {
   "parameters": {
    "jsCode": "const r = $json;\nconst out = (r.stdout || '').trim();\nconst err = (r.stderr || '').trim();\nif (r.code !== 0) throw new Error('生成 PDF 失败：' + err.split('\\n').slice(-6).join(' | '));\nconst line = out.split('\\n').filter(l => l.trim().startsWith('{')).pop() || '{}';\nreturn [{ json: JSON.parse(line) }];"
   },
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    272,
    0
   ],
   "id": "029feb60-4e3a-4004-99aa-831147fbb40a",
   "name": "解析结果"
  },
  {
   "parameters": {
    "jsCode": "const r = $json;\nconst AT = 'ou_06d848a891ff38012cf3e3ba20de7370';\nconst card = {\n  config: { wide_screen_mode: true },\n  header: { template: 'green', title: { tag: 'plain_text', content: '✅ Bill PDF 已生成' } },\n  elements: [\n    { tag: 'div', text: { tag: 'lark_md', content:\n      `**来源计算表**\\n\\`${r.xlsx}\\`\\n**PDF**\\n\\`${r.out}\\`\\n**订单** ${r.orders} 单\\n**合计** US$${r.subtotal}\\n**payment fee(0.5%)** US$${r.fee}\\n**Last Balance** US$${r.last_balance ?? 0}\\n**最终合计** US$${r.total}` } },\n    { tag: 'hr' },\n    { tag: 'div', text: { tag: 'lark_md', content: `<at id=\"${AT}\"></at>` } },\n  ],\n};\nreturn [{ json: { card } }];"
   },
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    512,
    0
   ],
